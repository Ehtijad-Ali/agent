# Copy to deploy/.env and fill in. Never commit the filled-in file.
# Generate each secret separately, e.g.:  openssl rand -hex 32

SIGNAL_DOMAIN=signal.joinallbettors.com
N8N_DOMAIN=n8n.joinallbettors.com
TIMEZONE=UTC

POSTGRES_PASSWORD=
N8N_DB_PASSWORD=
# n8n encrypts stored credentials with this. Losing it makes them unreadable.
N8N_ENCRYPTION_KEY=

# Shared secret between Signal and n8n. Must equal N8N_WEBHOOK_SECRET in
# backend/.env: Signal sends it on every event, and n8n sends it back as
# X-Signal-Secret when calling /api/automation/*.
SIGNAL_N8N_SECRET=

# A 3B model runs on a CPU-only VPS; qwen2.5:7b is better but ~2x slower.
OLLAMA_MODEL=qwen2.5:3b
