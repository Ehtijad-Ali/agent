# Signal backend configuration (spec §35).
# Copy to .env and fill in. NEVER commit the filled-in file — .env* is gitignored.

# --- core ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- database ---
# Phase 2 needs this: conversations, activity and scans are persisted, and the
# routes that touch them return 503 while it is blank. SQLite is the default so
# a local checkout works with no server to install -- the file is created on
# first boot and is gitignored.
#
# Nothing in the models or queries is dialect-specific, so deployment is a URL
# change. Docker Compose supplies the Postgres value, where the host is the
# service name rather than localhost:
#   DATABASE_URL=postgresql+psycopg://signal:CHANGE_ME@postgres:5432/signal
DATABASE_URL=sqlite:///./signal.db

# --- redis ---
# Same reasoning. Compose value:
#   REDIS_URL=redis://redis:6379/0
REDIS_URL=

# --- secrets ---
# Generate each independently: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# Salt for deterministic author pseudonymisation (spec §10). Changing this
# re-pseudonymises every author, which breaks the "one reply per person, ever"
# guarantee (spec §15) because prior outreach can no longer be matched.
# Set once, then treat as immutable.
PSEUDONYM_SALT=

# --- AI (spec §14) ---
# Which model serves the AI Agent and the AI summaries/replies: "ollama" runs on
# this server (no usage limits, CPU speed); "groq" is hosted (fast, but the free
# tier allows only 8,000 tokens per minute).
AI_PROVIDER=ollama
# Ollama runs in Docker next to Postgres (see /opt/signal/docker-compose.yml).
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Pull it first: docker exec signal-ollama-1 ollama pull qwen2.5:7b
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=600
OLLAMA_CONTEXT=8192
# AI-written summaries and replies for new leads scoring at least this.
AI_DRAFT_MIN_SCORE=40
AI_DRAFTS_PER_SCAN=25

# --- AI agent (Groq) ---
# Powers the AI Agent chat. Get a key at https://console.groq.com/keys.
# Server-side only: never put it in the frontend or commit it.
GROQ_API_KEY=
# Must support tool calling; web search needs openai/gpt-oss-120b or -20b.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SEARCH_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_SECONDS=90
# Hard limits per task and per user.
AGENT_MAX_ITERATIONS=12
AGENT_MAX_SECONDS=600
AGENT_MAX_TOKENS_PER_TASK=200000
AGENT_DAILY_TASKS_PER_USER=200
# Chats untouched for this many days are deleted at startup (0 = keep).
AGENT_RETENTION_DAYS=90

# --- Telegram (spec §8) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Discovery sources: public posts and comments by keyword ---
# Reddit app: https://www.reddit.com/prefs/apps (type "script").
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=signal-monitor/1.0 (by joinallbettors)
# YouTube Data API v3 key: https://console.cloud.google.com
YOUTUBE_API_KEY=
# Dedicated Telegram account: API id/hash from https://my.telegram.org, then run
# scripts/telegram_login.py once to get the session string. Keep it secret.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=

# --- Discord (spec §9) ---
# The bot needs the MESSAGE CONTENT privileged intent enabled in the Discord
# developer portal, and must be invited to each monitored server. Without it,
# message bodies arrive empty and nothing can be scored.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# --- public URL ---
# The origin recipients see in tracking links (tracking_service.public_url).
# It is baked into the reply text that gets POSTED TO A PLATFORM, so a wrong
# value is public and permanent -- a localhost link is dead for everyone but
# the machine that sent it. Defaults to http://localhost:8000, which is correct
# for local testing and WRONG the moment a reply leaves this machine.
# In production set it to the public HTTPS origin, e.g. https://signal.example.com
PUBLIC_BASE_URL=http://localhost:8000

# --- frontend / CORS (spec §38) ---
# Comma-separated exact origins. Never "*" in production.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- automation ---
N8N_BASE_URL=http://127.0.0.1:5678/n8n
N8N_WEBHOOK_SECRET=
# n8n webhook that receives strong new leads after each scan (empty = off),
# e.g. http://127.0.0.1:5678/n8n/webhook/new-lead
N8N_LEAD_WEBHOOK_URL=
LEAD_ALERT_MIN_SCORE=70

# --- welcome emails for new users (any SMTP provider; blank = no email) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- Google Sheets write-back for backlink audits (service-account JSON key) ---
GOOGLE_SERVICE_ACCOUNT_FILE=
