# Signal backend configuration (spec §35).
# Copy to .env and fill in. NEVER commit the filled-in file — .env* is gitignored.

# --- core ---
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- database ---
# Phase 2 needs this: conversations, activity and scans are persisted, and the
# routes that touch them return 503 while it is blank. SQLite is the default so
# a local checkout works with no server to install -- the file is created on
# first boot and is gitignored.
#
# Nothing in the models or queries is dialect-specific, so deployment is a URL
# change. Docker Compose supplies the Postgres value, where the host is the
# service name rather than localhost:
#   DATABASE_URL=postgresql+psycopg://signal:CHANGE_ME@postgres:5432/signal
DATABASE_URL=sqlite:///./signal.db

# --- redis ---
# Same reasoning. Compose value:
#   REDIS_URL=redis://redis:6379/0
REDIS_URL=

# --- secrets ---
# Generate each independently: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET=
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=14

# Salt for deterministic author pseudonymisation (spec §10). Changing this
# re-pseudonymises every author, which breaks the "one reply per person, ever"
# guarantee (spec §15) because prior outreach can no longer be matched.
# Set once, then treat as immutable.
PSEUDONYM_SALT=

# --- AI (spec §14) ---
# Model is configuration, never hard-coded in application code.
OLLAMA_BASE_URL=http://ollama:11434
# A small tool-calling model keeps the AI Agent responsive on a CPU server.
# Pull it once with: ollama pull qwen2.5:3b
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=120
# AI-written summaries and replies: at most this many per scan (CPU time).
AI_MAX_PER_SCAN=15
# AI Agent (assistant). Blank ASSISTANT_MODEL reuses OLLAMA_MODEL.
ASSISTANT_MODEL=
ASSISTANT_TIMEOUT_SECONDS=300
ASSISTANT_MAX_ITERATIONS=8
# Optional hosted fallback, used only when OLLAMA_MODEL is blank.
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# --- Telegram (spec §8) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# --- Discord (spec §9) ---
# The bot needs the MESSAGE CONTENT privileged intent enabled in the Discord
# developer portal, and must be invited to each monitored server. Without it,
# message bodies arrive empty and nothing can be scored.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=

# --- discovery connectors (read-only keyword search; Platforms screen) ---
# Reddit: reddit.com/prefs/apps -> create a "script" app.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=signal-discovery/0.1
# YouTube Data API v3 key from console.cloud.google.com.
YOUTUBE_API_KEY=
# Telegram user account (MTProto) from my.telegram.org. Needs `pip install
# telethon` and a one-time sign-in: python scripts/telegram_login.py
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION=telegram_account

# --- public URL ---
# The origin recipients see in tracking links (tracking_service.public_url).
# It is baked into the reply text that gets POSTED TO A PLATFORM, so a wrong
# value is public and permanent -- a localhost link is dead for everyone but
# the machine that sent it. Defaults to http://localhost:8000, which is correct
# for local testing and WRONG the moment a reply leaves this machine.
# In production set it to the public HTTPS origin, e.g. https://signal.example.com
PUBLIC_BASE_URL=http://localhost:8000

# --- frontend / CORS (spec §38) ---
# Comma-separated exact origins. Never "*" in production.
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- automation ---
N8N_BASE_URL=http://n8n:5678
N8N_WEBHOOK_SECRET=
# n8n Webhook node Signal posts events to; blank turns events off.
# Docker Compose sets it to http://n8n:5678/webhook/signal-events
N8N_WEBHOOK_URL=
